MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 731c18a30d5243ce9cd95070ccb54d6f, type: 3}
  m_Name: DescriptionTermCatalog
  m_EditorClassIdentifier: Assembly-CSharp::DescriptionTermCatalog
  Entries:
  - Id: combat-drone
    DisplayName: "\uC804\uD22C \uB4DC\uB860"
    Color: {r: 0.46, g: 0.26, b: 0.69, a: 1}
    Body: "\uBCA0\uD0D5, \uAC10\uB9DD, \uB378\uD0D5\uC774 \uC6B4\uC6A9\uD558\uB294
      \uC77C\uBC18 \uACF5\uACA9\uC6A9 \uB4DC\uB860\uC785\uB2C8\uB2E4. \uC561\uD2F0\uBE0C
      \uC2A4\uD0AC\uC758 \uACF5\uACA9\uC5D0\uB3C4 \uCC38\uC5EC\uD569\uB2C8\uB2E4.
      \uCD94\uAC00 \uC804\uD22C \uB4DC\uB860\uC740 \uBCF8\uCCB4\uC758 \uC2A4\uD0AC\uC744
      \uB300\uC2E0 \uC0AC\uC6A9\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
  - Id: bomb-drone
    DisplayName: "\uC790\uD3ED \uB4DC\uB860"
    Color: {r: 0.46, g: 0.26, b: 0.69, a: 1}
    Body: "\uBCA0\uD0D5\uC758 \uC2A4\uD0AC\uB85C \uC0DD\uC131\uB418\uC5B4 \uBCF4\uC2A4\uC5D0\uAC8C
      \uC811\uADFC\uD55C \uB4A4 \uD3ED\uBC1C\uD558\uB294 \uB4DC\uB860\uC785\uB2C8\uB2E4.
      \uC77C\uBC18 \uACF5\uACA9\uC6A9 \uC804\uD22C \uB4DC\uB860\uACFC \uBCC4\uB3C4\uB85C
      \uC0DD\uC131\uB429\uB2C8\uB2E4."
  - Id: alphan-active
    DisplayName: "\uC561\uD2F0\uBE0C \uC2A4\uD0AC"
    Color: {r: 0.46, g: 0.26, b: 0.69, a: 1}
    Body: "\uBC84\uD2BC\uC744 \uB20C\uB7EC \uC4F0\uB294 \uC871\uC7A5\uC758 \uC2A4\uD0AC\uC785\uB2C8\uB2E4.
      \uD544\uB4DC\uC758 \uC804\uD22C \uB4DC\uB860\uC774 \uBAA8\uC5EC \uC77C\uC81C
      \uC0AC\uACA9\uD569\uB2C8\uB2E4. \uC120\uD0DD\uC9C0\uC5D0 \uB530\uB77C \uCFE8\uD0C0\uC784,
      \uBCF4\uAD00 \uD69F\uC218, \uD53C\uD574, \uD574\uD0B9 \uC2A4\uD0DD \uAE30\uD3ED\uC774
      \uB2EC\uB77C\uC9D1\uB2C8\uB2E4."
  - Id: gamman-buff
    DisplayName: "\uAC10\uB9DD \uAE30\uD3ED"
    Color: {r: 0.46, g: 0.26, b: 0.69, a: 1}
    Body: "\uAC10\uB9DD\uC740 \uD574\uD0B9 \uC2A4\uD0DD\uC744 \uC18C\uBE44\uD574
      \uAE30\uBCF8 \uC2A4\uD0AC \uD53C\uD574\uC5D0 \uCD94\uAC00 \uD53C\uD574\uB97C
      \uB354\uD569\uB2C8\uB2E4. \uC8FC\uD30C\uC218 \uB3D9\uC870\uB294 \uC2A4\uD0DD
      \uCD94\uAC00 \uD53C\uD574 \uBC30\uC728\uC744 \uB192\uC774\uACE0, \uAE34\uAE09
      \uAD50\uC2E0\uC740 \uC561\uD2F0\uBE0C \uC2A4\uD0AC \uC801\uC911 \uC2DC \uBCF4\uC2A4\uC758
      \uD574\uD0B9 \uC2A4\uD0DD\uC744 \uBAA8\uB450 \uC18C\uBAA8\uD574 \uAE30\uD3ED\uD569\uB2C8\uB2E4."
  - Id: zeltan-production
    DisplayName: "\uC824\uD0D5 \uC2DD\uB7C9 \uC0DD\uC0B0"
    Color: {r: 0.46, g: 0.26, b: 0.69, a: 1}
    Body: "\uC824\uD0D5\uC758 \uC790\uCCB4 \uC0DD\uC0B0\uACFC \uC804\uC7A5 \uC804\uD22C
      \uB4DC\uB860 \uC218\uC5D0 \uBE44\uB840\uD55C \uC0DD\uC0B0\uC785\uB2C8\uB2E4.
      \uC5D0\uC5B4\uD504\uB77C\uC774\uAE30\uB294 \uB450 \uC0DD\uC0B0\uB7C9\uC744
      \uB192\uC774\uACE0 \uC2E4\uC81C \uC0DD\uC0B0\uD55C \uC2DD\uB7C9\uC744 3\uCD08\uB9C8\uB2E4
      \uD568\uAED8 \uC9C0\uAE09\uD569\uB2C8\uB2E4."
  - Id: merge
    DisplayName: "\uD569\uC131"
    Color: {r: 0.46, g: 0.26, b: 0.69, a: 1}
    Body: "\uAC19\uC740 \uC885\uB958\uC640 \uB4F1\uAE09\uC758 \uC720\uB2DB\uC744
      \uD569\uCCD0 \uB2E4\uC74C \uB4F1\uAE09 \uC720\uB2DB\uC744 \uB9CC\uB4DC\uB294
      \uD589\uB3D9\uC785\uB2C8\uB2E4. \uC9C0\uC6D0 \uC694\uCCAD \uBC14\uB78C\uC740
      \uD569\uC131\uC774 \uC77C\uC5B4\uB0A0 \uB54C \uCD94\uAC00 \uB178\uB9D0 \uC720\uB2DB
      \uC0DD\uC131 \uD655\uB960\uC744 \uC801\uC6A9\uD569\uB2C8\uB2E4."
  - Id: hacking-stack
    DisplayName: "\uD574\uD0B9 \uC2A4\uD0DD"
    Color: {r: 0.46, g: 0.26, b: 0.69, a: 1}
    Body: "\uB378\uD0D5\uC774 \uC77C\uBC18 \uACF5\uACA9\uC73C\uB85C \uC644\uCDA9\uD55C
      \uB4A4 \uC0DD\uC0B0\uD558\uB294 \uC790\uC6D0\uC785\uB2C8\uB2E4. \uAC10\uB9DD\uC740
      \uB300\uC0C1\uC758 \uD574\uD0B9 \uC2A4\uD0DD\uC744 \uB4F1\uAE09\uBCC4 \uD55C\uB3C4\uAE4C\uC9C0
      \uC18C\uBE44\uD574 \uC2A4\uD0AC\uC5D0 \uCD94\uAC00 \uD53C\uD574\uB97C \uB354\uD569\uB2C8\uB2E4."
  - Id: deltan-charge
    DisplayName: "\uB378\uD0D5 \uC644\uCDA9"
    Color: {r: 0.46, g: 0.26, b: 0.69, a: 1}
    Body: "\uB378\uD0D5\uC740 \uC77C\uBC18 \uACF5\uACA9\uC73C\uB85C \uCDA9\uC804\uD569\uB2C8\uB2E4.
      \uAE30\uBCF8 \uCDA9\uC804\uB7C9\uC740 6\uC774\uBA70 \uB139... \uD68D\uB4DD
      \uC2DC 9\uAC00 \uB418\uACE0, \uACE0\uC815 \uCD94\uAC00\uBD84\uC744 \uD3EC\uD568\uD55C
      \uD574\uD0B9 \uC0DD\uC0B0\uB7C9\uC774 2\uBC30\uAC00 \uB429\uB2C8\uB2E4. \uB9C8\uB098
      \uD68C\uBCF5\uC740 \uC774 \uCDA9\uC804\uC5D0 \uC801\uC6A9\uB429\uB2C8\uB2E4."
