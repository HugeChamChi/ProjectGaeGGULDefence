  _entries:
  - Id: chief_skill
    DisplayName: "\uC561\uD2F0\uBE0C \uC2A4\uD0AC"
    Aliases:
    - "\uC561\uD2F0\uBE0C \uC2A4\uD0AC"
    - "\uC871\uC7A5 \uC2A4\uD0AC"
    - "\uC54C\uD321 \uC561\uD2F0\uBE0C"
    - "\uC9D1\uACB0 \uC0AC\uACA9"
    - "\uC871\uC7A5 \uC2A4\uD0AC\uC0AC\uC6A9"
    RelatedTerms: []
    Kind: "\uC871\uC7A5"
    KindColor: {r: 0.62, g: 0.38, b: 0.95, a: 1}
    Body: "\uBC84\uD2BC\uC744 \uB20C\uB7EC \uB4DC\uB860\uC744 \uBAA8\uC544 \uC77C\uC81C
      \uC0AC\uACA9\uD569\uB2C8\uB2E4. \uBCF4\uC2A4\uC758 \uD328\uD134\uC744 \uB04A\uC744\uC218
      \uC788\uC2B5\uB2C8\uB2E4."
    BriefBody: "\uBC84\uD2BC\uC744 \uB20C\uB7EC \uB4DC\uB860\uC744 \uBAA8\uC544 \uC77C\uC81C
      \uC0AC\uACA9\uD569\uB2C8\uB2E4. \uBCF4\uC2A4\uC758 \uD328\uD134\uC744 \uB04A\uC744\uC218
      \uC788\uC2B5\uB2C8\uB2E4."
    DetailedBody: "\uCC38\uC5EC \uB4DC\uB860\uC774 \uB9CE\uC744\uC218\uB85D \uD53C\uD574\uAC00
      \uCEE4\uC9D1\uB2C8\uB2E4. \uBCF4\uC2A4\uC758 \uD328\uD134\uC744 \uB04A\uC744
      \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    FactKind: 1
    FactSource: {fileID: 11400000, guid: 9b14e4c5d103a3d4fb44aa5f049606bd, type: 2}
    Clip: {fileID: 32900000, guid: e9ee8c38ee860324196c70482ca9b805, type: 3}
    ClipCaption: "\uC561\uD2F0\uBE0C \uC2A4\uD0AC \u2014 \uC77C\uC81C \uC0AC\uACA9\uACFC
      \uC608\uACE0 \uB04A\uAE30"
  - Id: self_destruct_drone
    DisplayName: "\uC790\uD3ED \uB4DC\uB860"
    Aliases:
    - "\uC790\uD3ED \uB4DC\uB860"
    - "\uC790\uD3ED\uB4DC\uB860"
    RelatedTerms: []
    Kind: "\uC720\uB2DB"
    KindColor: {r: 0.3, g: 0.55, b: 0.94, a: 1}
    Body: "\uBCF4\uC2A4\uC5D0\uAC8C \uB3CC\uC9C4\uD574 \uD3ED\uBC1C\uD558\uB294 \uB4DC\uB860\uC785\uB2C8\uB2E4."
    BriefBody: "\uBCF4\uC2A4\uC5D0\uAC8C \uB3CC\uC9C4\uD574 \uD3ED\uBC1C\uD558\uB294
      \uB4DC\uB860\uC785\uB2C8\uB2E4."
    DetailedBody: "\uAE30\uBCF8 \uD53C\uD574\uB294 \uC18C\uC720 \uC720\uB2DB \uACF5\uACA9\uB825
      \xD7{coefficient}\uB97C \uAE30\uC900\uC73C\uB85C \uACC4\uC0B0\uD569\uB2C8\uB2E4.
      \uD3ED\uD0C4\uB9C8\uB2E4 \uCE58\uBA85\uD0C0\uB97C \uB530\uB85C \uD310\uC815\uD569\uB2C8\uB2E4."
    FactKind: 2
    FactSource: {fileID: 11400000, guid: ae86a677bf70a6643b6895c15d70c469, type: 2}
    Clip: {fileID: 32900000, guid: 236ca4b8e0134874893f87acc07e9676, type: 3}
    ClipCaption: "\uC790\uD3ED \uB4DC\uB860"
  - Id: hack_stack
    DisplayName: "\uD574\uD0B9"
    Aliases:
    - "\uD574\uD0B9 \uC2DC\uC2A4\uD15C"
    - "\uD574\uD0B9 \uC2A4\uD0DD"
    - "\uD574\uD0B9\uC2A4\uD0DD"
    - "\uD574\uD0B9"
    - "\uD574\uD0B9 \uC2A4\uD0AC"
    - "\uD574\uD0B9\uC2A4\uD0AC"
    RelatedTerms:
    - detonation
    Kind: "\uC790\uC6D0"
    KindColor: {r: 0.16, g: 0.55, b: 0.75, a: 1}
    Body: "\uBCF4\uC2A4\uC5D0\uAC8C \uC2A4\uD0DD\uC744 \uC313\uC544 \uAE30\uD3ED
      \uD53C\uD574\uB97C \uB192\uC785\uB2C8\uB2E4."
    BriefBody: "\uBCF4\uC2A4\uC5D0\uAC8C \uC2A4\uD0DD\uC744 \uC313\uC544 \uAE30\uD3ED
      \uD53C\uD574\uB97C \uB192\uC785\uB2C8\uB2E4."
    DetailedBody: "\uAC19\uC740 \uBCF4\uC2A4\uC758 \uC2A4\uD0DD\uC744 \uACF5\uC720\uD558\uBA70
      \uCD5C\uB300 {capacity}\uAC1C\uAE4C\uC9C0 \uC313\uC2B5\uB2C8\uB2E4. \uAE30\uD3ED
      \uC2DC \uC18C\uBE44\uD55C \uC2A4\uD0DD\uB9CC\uD07C \uCD94\uAC00 \uD53C\uD574\uB97C
      \uC90D\uB2C8\uB2E4."
    FactKind: 3
    FactSource: {fileID: 11400000, guid: 6770f25b048611949929596efc470881, type: 2}
    Clip: {fileID: 32900000, guid: f0cf635d09c435b44b116ab62882161e, type: 3}
    ClipCaption: "\uD574\uD0B9 \u2014 \uC2A4\uD0DD \uCD95\uC801\uACFC \uAE30\uD3ED"
  - Id: time_manipulation
    DisplayName: "\uAE00\uB9AC\uCE58"
    Aliases:
    - "\uC2DC\uAC04\uC870\uC791"
    - "\uC2DC\uAC04 \uC870\uC791"
    - "\uC2DC\uAC04 \uC18C\uBE44"
    - "\uC2DC\uAC04 \uD68C\uBCF5"
    - "\uAE00\uB9AC\uCE58"
    RelatedTerms: []
    Kind: "\uADDC\uCE59"
    KindColor: {r: 0.85, g: 0.55, b: 0.2, a: 1}
    Body: "\uC2DC\uAC04\uC744 \uD68C\uBCF5\uD558\uAC70\uB098 \uC18C\uBAA8\uD574 \uCD94\uAC00
      \uD6A8\uACFC\uB97C \uC5BB\uC2B5\uB2C8\uB2E4."
    BriefBody: "\uC2DC\uAC04\uC744 \uD68C\uBCF5\uD558\uAC70\uB098 \uC18C\uBAA8\uD574
      \uCD94\uAC00 \uD6A8\uACFC\uB97C \uC5BB\uC2B5\uB2C8\uB2E4."
    DetailedBody: "\uD68C\uBCF5\uC740 \uB0A8\uC740 \uC2DC\uAC04\uC744 \uB298\uB9AC\uACE0,
      \uC18C\uBE44\uB294 \uC2DC\uAC04\uC744 \uC9C0\uBD88\uD574 \uD6A8\uACFC\uB97C
      \uC5BB\uC2B5\uB2C8\uB2E4. \uC790\uC5F0 \uAC10\uC18C\uB294 \uC18C\uBE44\uC5D0
      \uD3EC\uD568\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
    FactKind: 4
    FactSource: {fileID: 11400000, guid: 9971529ae82c8aa43b24453abd9f8d7a, type: 2}
    Clip: {fileID: 32900000, guid: 301b7986938bf594f896eeec800b07f1, type: 3}
    ClipCaption: "\uAE00\uB9AC\uCE58 \u2014 \uACF5\uACA9 \uCDA9\uC804\uACFC \uC2DC\uAC04
      \uD68C\uBCF5"
  - Id: combat_drone
    DisplayName: "\uC804\uD22C \uB4DC\uB860"
    Aliases:
    - "\uC804\uD22C \uB4DC\uB860"
    - "\uC804\uD22C\uB4DC\uB860"
    RelatedTerms: []
    Kind: "\uADDC\uCE59"
    KindColor: {r: 0.16, g: 0.55, b: 0.75, a: 1}
    Body: "\uC720\uB2DB \uACC1\uC5D0\uC11C \uBCF4\uC2A4\uB97C \uACF5\uACA9\uD558\uB294
      \uB4DC\uB860\uC785\uB2C8\uB2E4."
    BriefBody: "\uC720\uB2DB \uACC1\uC5D0\uC11C \uBCF4\uC2A4\uB97C \uACF5\uACA9\uD558\uB294
      \uB4DC\uB860\uC785\uB2C8\uB2E4."
    DetailedBody: "\uC77C\uBC18 \uACF5\uACA9\uC744 \uBC18\uBCF5\uD558\uACE0 \uC561\uD2F0\uBE0C
      \uC2A4\uD0AC\uC5D0 \uCC38\uC5EC\uD569\uB2C8\uB2E4. \uC790\uD3ED \uB4DC\uB860\uC740
      \uAC1C\uC218\uC5D0 \uD3EC\uD568\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
    FactKind: 0
    FactSource: {fileID: 0}
    Clip: {fileID: 0}
    ClipCaption: 
  - Id: mana
    DisplayName: "\uB9C8\uB098"
    Aliases:
    - "\uB9C8\uB098"
    RelatedTerms: []
    Kind: "\uADDC\uCE59"
    KindColor: {r: 0.16, g: 0.55, b: 0.75, a: 1}
    Body: "\uC2A4\uD0AC \uC0AC\uC6A9\uC5D0 \uD544\uC694\uD55C \uCDA9\uC804\uB7C9\uC785\uB2C8\uB2E4."
    BriefBody: "\uC2A4\uD0AC \uC0AC\uC6A9\uC5D0 \uD544\uC694\uD55C \uCDA9\uC804\uB7C9\uC785\uB2C8\uB2E4."
    DetailedBody: "\uC77C\uBC18 \uACF5\uACA9\uC73C\uB85C \uBAA8\uC73C\uBA70, \uC644\uCDA9
      \uD6C4 \uC2A4\uD0AC\uC744 \uC4F0\uBA74 \uBE44\uC6CC\uC9D1\uB2C8\uB2E4."
    FactKind: 0
    FactSource: {fileID: 0}
    Clip: {fileID: 0}
    ClipCaption: 
  - Id: detonation
    DisplayName: "\uAE30\uD3ED"
    Aliases:
    - "\uAE30\uD3ED"
    RelatedTerms: []
    Kind: "\uADDC\uCE59"
    KindColor: {r: 0.16, g: 0.55, b: 0.75, a: 1}
    Body: "\uD574\uD0B9 \uC2A4\uD0DD\uC744 \uC18C\uBE44\uD574 \uD53C\uD574\uB97C
      \uC8FC\uB294 \uACF5\uACA9\uC785\uB2C8\uB2E4."
    BriefBody: "\uD574\uD0B9 \uC2A4\uD0DD\uC744 \uC18C\uBE44\uD574 \uD53C\uD574\uB97C
      \uC8FC\uB294 \uACF5\uACA9\uC785\uB2C8\uB2E4."
    DetailedBody: "\uC18C\uBE44\uB7C9\uC774 \uB9CE\uC744\uC218\uB85D \uCD94\uAC00
      \uD53C\uD574\uAC00 \uCEE4\uC9D1\uB2C8\uB2E4. \uC2A4\uD0DD\uC774 \uC5C6\uC5B4\uB3C4
      \uAE30\uBCF8 \uD53C\uD574\uB97C \uC90D\uB2C8\uB2E4."
    FactKind: 0
    FactSource: {fileID: 0}
    Clip: {fileID: 0}
    ClipCaption: 
  - Id: skill_charge
    DisplayName: "\uC2A4\uD0AC \uCFE8\uD0C0\uC784"
    Aliases:
    - "\uD574\uD0B9 \uCDA9\uC804\uB7C9"
    - "\uC2A4\uD0AC \uCFE8\uD0C0\uC784"
    - "\uC2A4\uD0AC \uCDA9\uC804"
    RelatedTerms: []
    Kind: "\uADDC\uCE59"
    KindColor: {r: 0.16, g: 0.55, b: 0.75, a: 1}
    Body: "\uB2E4\uC74C \uC2A4\uD0AC\uC744 \uC4F8 \uB54C\uAE4C\uC9C0 \uCC44\uC6B0\uB294
      \uAC8C\uC774\uC9C0\uC785\uB2C8\uB2E4."
    BriefBody: "\uB2E4\uC74C \uC2A4\uD0AC\uC744 \uC4F8 \uB54C\uAE4C\uC9C0 \uCC44\uC6B0\uB294
      \uAC8C\uC774\uC9C0\uC785\uB2C8\uB2E4."
    DetailedBody: "\uC720\uB2DB\uC5D0 \uB530\uB77C \uC2DC\uAC04\uC774\uB098 \uACF5\uACA9
      \uD69F\uC218\uB85C \uCC44\uC6C1\uB2C8\uB2E4."
    FactKind: 0
    FactSource: {fileID: 0}
    Clip: {fileID: 0}
    ClipCaption: 
  - Id: food
    DisplayName: "\uC2DD\uB7C9"
    Aliases:
    - "\uC2DD\uB7C9"
    RelatedTerms: []
    Kind: "\uADDC\uCE59"
    KindColor: {r: 0.16, g: 0.55, b: 0.75, a: 1}
    Body: "\uC720\uB2DB \uCD9C\uACA9\uACFC \uAC15\uD654\uC5D0 \uC4F0\uB294 \uC7AC\uD654\uC785\uB2C8\uB2E4."
    BriefBody: "\uC720\uB2DB \uCD9C\uACA9\uACFC \uAC15\uD654\uC5D0 \uC4F0\uB294 \uC7AC\uD654\uC785\uB2C8\uB2E4."
    DetailedBody: "\uC720\uB2DB\uACFC \uC804\uD22C \uB4DC\uB860\uC774 \uC0DD\uC0B0\uD558\uBA70,
      \uC0DD\uC0B0\uB7C9\uC740 \uD604\uC7AC \uD6A8\uACFC\uC5D0 \uB530\uB77C \uB2EC\uB77C\uC9D1\uB2C8\uB2E4."
    FactKind: 0
    FactSource: {fileID: 0}
    Clip: {fileID: 0}
    ClipCaption: 
  - Id: merge
    DisplayName: "\uD569\uC131"
    Aliases:
    - "\uD569\uC131"
    RelatedTerms: []
    Kind: "\uADDC\uCE59"
    KindColor: {r: 0.16, g: 0.55, b: 0.75, a: 1}
    Body: "\uB450 \uC720\uB2DB\uC744 \uD569\uCCD0 \uC0C1\uC704 \uB4F1\uAE09\uC744
      \uC5BB\uC2B5\uB2C8\uB2E4."
    BriefBody: "\uB450 \uC720\uB2DB\uC744 \uD569\uCCD0 \uC0C1\uC704 \uB4F1\uAE09\uC744
      \uC5BB\uC2B5\uB2C8\uB2E4."
    DetailedBody: "\uD569\uC131 \uAC00\uB2A5\uD55C \uAC19\uC740 \uC720\uB2DB\uACFC
      \uAC19\uC740 \uC18C\uC720 \uB4F1\uAE09\uB07C\uB9AC \uD569\uCE69\uB2C8\uB2E4.
      \uB178\uB9D0 \uC870\uCEE4\uB294 \uC608\uC678\uC785\uB2C8\uB2E4."
    FactKind: 0
    FactSource: {fileID: 0}
    Clip: {fileID: 0}
    ClipCaption: 
  - Id: upgrade
    DisplayName: "\uAC15\uD654"
    Aliases:
    - "\uAC15\uD654"
    RelatedTerms: []
    Kind: "\uADDC\uCE59"
    KindColor: {r: 0.16, g: 0.55, b: 0.75, a: 1}
    Body: "\uC2DD\uB7C9\uC73C\uB85C \uD574\uB2F9 \uC720\uB2DB \uC885\uB958\uB97C
      \uAC15\uD654\uD569\uB2C8\uB2E4."
    BriefBody: "\uC2DD\uB7C9\uC73C\uB85C \uD574\uB2F9 \uC720\uB2DB \uC885\uB958\uB97C
      \uAC15\uD654\uD569\uB2C8\uB2E4."
    DetailedBody: "\uACF5\uACA9\uB825\uACFC \uACF5\uACA9 \uC18D\uB3C4 \uB4F1\uC744
      \uC62C\uB9AC\uBA70 \uB2E4\uC74C \uBE44\uC6A9\uC740 \uD604\uC7AC \uAC15\uD654
      \uB2E8\uACC4\uC5D0 \uB530\uB985\uB2C8\uB2E4."
    FactKind: 0
    FactSource: {fileID: 0}
    Clip: {fileID: 0}
    ClipCaption: 
