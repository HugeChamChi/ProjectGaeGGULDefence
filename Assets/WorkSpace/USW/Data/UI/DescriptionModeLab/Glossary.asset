  m_Name: Glossary
  m_EditorClassIdentifier: Assembly-CSharp::TermGlossary
  _entries:
  - Id: chief_skill
    DisplayName: "\uC871\uC7A5 \uC2A4\uD0AC"
    Aliases:
    - "\uC871\uC7A5 \uC2A4\uD0AC"
    - "\uC561\uD2F0\uBE0C \uC2A4\uD0AC"
    - "\uC54C\uD321 \uC561\uD2F0\uBE0C"
    Kind: "\uC871\uC7A5"
    KindColor: {r: 0.62, g: 0.38, b: 0.95, a: 1}
    Body: "\uC67C\uCABD \uC544\uB798 \uC871\uC7A5 \uBC84\uD2BC\uC744 \uB20C\uB7EC
      \uC9C1\uC811 \uC4F0\uB294 \uAE30\uC220\uC785\uB2C8\uB2E4. \uC9C0\uAE08 \uC871\uC7A5
      \uC54C\uD321\uC740 \uB4DC\uB860\uC744 \uBAA8\uC544 \uBCF4\uC2A4\uC5D0\uAC8C
      \uC77C\uC81C \uC0AC\uACA9\uD569\uB2C8\uB2E4. \uCFE8\uD0C0\uC784\uC774 \uB2E4
      \uCC28\uC57C \uC4F8 \uC218 \uC788\uACE0, \uBAA8\uC77C \uB4DC\uB860\uC774 \uC5C6\uC73C\uBA74
      \uBC1C\uB3D9\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4. \uC545\uC5B4 \uBCF4\uC2A4\uAC00
      \uC9C0\uC9C4\uC744 \uC608\uACE0\uD558\uB294 \uB3D9\uC548 \uC4F0\uBA74 \uADF8
      \uC608\uACE0\uB97C \uB04A\uC2B5\uB2C8\uB2E4. \uC120\uD0DD\uC9C0\uC5D0 \uB530\uB77C
      \uD53C\uD574\xB7\uCFE8\uD0C0\uC784\xB7\uC0AC\uACA9 \uD69F\uC218\uAC00 \uB2EC\uB77C\uC9D1\uB2C8\uB2E4."
    BriefBody: "\uBC84\uD2BC\uC744 \uB20C\uB7EC \uB4DC\uB860\uC744 \uBAA8\uC544 \uC77C\uC81C
      \uC0AC\uACA9\uD569\uB2C8\uB2E4."
    DetailedBody: "\uCC38\uC5EC \uB4DC\uB860\uC774 \uB9CE\uC744\uC218\uB85D \uD53C\uD574\uAC00
      \uCEE4\uC9D1\uB2C8\uB2E4. \uBCF4\uC2A4\uC758 \uD328\uD134\uC744 \uB04A\uC744
      \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    FactKind: 1
    FactSource: {fileID: 11400000, guid: 9b14e4c5d103a3d4fb44aa5f049606bd, type: 2}
    Clip: {fileID: 32900000, guid: e9ee8c38ee860324196c70482ca9b805, type: 3}
    ClipCaption: "\uC871\uC7A5 \uC2A4\uD0AC \u2014 \uC77C\uC81C \uC0AC\uACA9 \xB7
      \uC608\uACE0 \uB04A\uAE30"
  - Id: self_destruct_drone
    DisplayName: "\uC790\uD3ED \uB4DC\uB860"
    Aliases:
    - "\uC790\uD3ED \uB4DC\uB860"
    - "\uC790\uD3ED\uB4DC\uB860"
    Kind: "\uC720\uB2DB"
    KindColor: {r: 0.3, g: 0.55, b: 0.94, a: 1}
    Body: "\uBCA0\uD0D5\uC774 \uC2A4\uD0AC\uC744 \uCC44\uC6B0\uBA74 \uB0B4\uBCF4\uB0B4\uB294
      \uC18C\uBAA8\uC131 \uB4DC\uB860\uC785\uB2C8\uB2E4. \uC7A0\uC2DC \uD798\uC744
      \uBAA8\uC740 \uB4A4 \uBCF4\uC2A4\uC5D0\uAC8C \uB3CC\uC9C4\uD574 \uD3ED\uBC1C\uD558\uACE0
      \uC0AC\uB77C\uC9D1\uB2C8\uB2E4. \uC120\uD0DD\uC9C0\uB85C \uB354 \uB9CC\uB4E4\uC5B4\uC9C0\uAE30\uB3C4
      \uD558\uBA70, \uD3ED\uD0C4\uB9C8\uB2E4 \uB530\uB85C \uD53C\uD574\uC640 \uCE58\uBA85\uD0C0\uB97C
      \uD310\uC815\uD569\uB2C8\uB2E4."
    BriefBody: "\uBCF4\uC2A4\uC5D0\uAC8C \uB3CC\uC9C4\uD574 \uD3ED\uBC1C\uD558\uB294
      \uB4DC\uB860\uC785\uB2C8\uB2E4."
    DetailedBody: "\uAE30\uBCF8 \uD53C\uD574\uB294 \uC18C\uC720 \uC720\uB2DB \uACF5\uACA9\uB825
      \xD7{coefficient}\uB97C \uAE30\uC900\uC73C\uB85C \uACC4\uC0B0\uD569\uB2C8\uB2E4.
      \uD3ED\uD0C4\uB9C8\uB2E4 \uCE58\uBA85\uD0C0\uB97C \uB530\uB85C \uD310\uC815\uD569\uB2C8\uB2E4."
    FactKind: 2
    FactSource: {fileID: 11400000, guid: ae86a677bf70a6643b6895c15d70c469, type: 2}
    Clip: {fileID: 32900000, guid: 236ca4b8e0134874893f87acc07e9676, type: 3}
    ClipCaption: "\uC790\uD3ED \uB4DC\uB860"
  - Id: hack_stack
    DisplayName: "\uD574\uD0B9"
    Aliases:
    - "\uD574\uD0B9 \uC2A4\uD0DD"
    - "\uD574\uD0B9\uC2A4\uD0DD"
    - "\uD574\uD0B9"
    Kind: "\uC790\uC6D0"
    KindColor: {r: 0.16, g: 0.55, b: 0.75, a: 1}
    Body: "\uB378\uD0D5\uC758 \uD574\uD0B9\uC73C\uB85C \uBCF4\uC2A4\uC5D0\uAC8C \uC313\uC544
      \uB450\uB294 \uACF5\uC720 \uC790\uC6D0\uC785\uB2C8\uB2E4. \uAC10\uB9DD\uC774
      \uC2A4\uD0AC\uB85C \uC2A4\uD0DD\uC744 \uC18C\uBE44\uD574 \uAE30\uD3ED\uD558\uBA74
      \uC18C\uBE44\uD55C \uB9CC\uD07C \uCD94\uAC00 \uD53C\uD574\uB97C \uC90D\uB2C8\uB2E4.
      \uAC19\uC740 \uBCF4\uC2A4\uC758 \uC2A4\uD0DD\uC740 \uB378\uD0D5\uACFC \uAC10\uB9DD\uC774
      \uD568\uAED8 \uC4F0\uBA70, \uBCF4\uC2A4\uB97C \uCC98\uCE58\uD558\uBA74 \uC0AC\uB77C\uC9D1\uB2C8\uB2E4."
    BriefBody: "\uBCF4\uC2A4\uC5D0\uAC8C \uC2A4\uD0DD\uC744 \uC313\uC544 \uAE30\uD3ED
      \uD53C\uD574\uB97C \uB192\uC785\uB2C8\uB2E4."
    DetailedBody: "\uAC19\uC740 \uBCF4\uC2A4\uC758 \uC2A4\uD0DD\uC744 \uACF5\uC720\uD558\uBA70
      \uCD5C\uB300 {capacity}\uAC1C\uAE4C\uC9C0 \uC313\uC2B5\uB2C8\uB2E4. \uAE30\uD3ED
      \uC2DC \uC18C\uBE44\uD55C \uC2A4\uD0DD\uB9CC\uD07C \uCD94\uAC00 \uD53C\uD574\uB97C
      \uC90D\uB2C8\uB2E4."
    FactKind: 3
    FactSource: {fileID: 11400000, guid: 6770f25b048611949929596efc470881, type: 2}
    Clip: {fileID: 0}
    ClipCaption: 
  - Id: time_manipulation
    DisplayName: "\uAE00\uB9AC\uCE58"
    Aliases:
    - "\uC2DC\uAC04\uC870\uC791"
    - "\uC2DC\uAC04 \uC870\uC791"
    - "\uC2DC\uAC04 \uC18C\uBE44"
    - "\uC2DC\uAC04 \uD68C\uBCF5"
    - "\uAE00\uB9AC\uCE58"
    Kind: "\uADDC\uCE59"
    KindColor: {r: 0.85, g: 0.55, b: 0.2, a: 1}
    Body: "\uB0A8\uC740 \uC2DC\uAC04\uC744 \uB2E4\uB8E8\uB294 \uD6A8\uACFC\uC785\uB2C8\uB2E4.
      \uB514\uC2DC\uADF8\uB9DD\uC740 \uC2A4\uD0AC\uC744 \uC4F8 \uB54C\uB9C8\uB2E4
      \uB0A8\uC740 \uC2DC\uAC04\uC744 \uBC14\uB85C \uD68C\uBCF5\uD558\uACE0, \uC624\uBC84\uB4DC\uB77C\uC774\uBE0C
      \uD6A8\uACFC\uB294 \uC2DC\uAC04\uC744 \uC368\uC11C \uACF5\uACA9\uB825\xB7\uACF5\uC18D\xB7\uD569\uC131\xB7\uD574\uD0B9
      \uD6A8\uC728 \uAC19\uC740 \uC774\uB4DD\uC744 \uC5BB\uC2B5\uB2C8\uB2E4. \uC2DC\uAC04\uC774
      \uC800\uC808\uB85C \uC904\uC5B4\uB4DC\uB294 \uAC83\uC740 \uC18C\uBE44\uAC00
      \uC544\uB2C8\uBA70, \uB0A8\uC740 \uC2DC\uAC04\uC774 0\uCD08\uAC00 \uB418\uBA74
      \uBC14\uB85C \uD328\uBC30\uD569\uB2C8\uB2E4(\uC2DC\uAC04 \uAE08\uACE0 \uD6A8\uACFC
      \uC81C\uC678)."
    BriefBody: "\uC2DC\uAC04\uC744 \uD68C\uBCF5\uD558\uAC70\uB098 \uC18C\uBAA8\uD574
      \uCD94\uAC00 \uD6A8\uACFC\uB97C \uC5BB\uC2B5\uB2C8\uB2E4."
    DetailedBody: "\uD68C\uBCF5\uC740 \uB0A8\uC740 \uC2DC\uAC04\uC744 \uB298\uB9AC\uACE0,
      \uC18C\uBE44\uB294 \uC2DC\uAC04\uC744 \uC9C0\uBD88\uD574 \uD6A8\uACFC\uB97C
      \uC5BB\uC2B5\uB2C8\uB2E4. \uC790\uC5F0 \uAC10\uC18C\uB294 \uC18C\uBE44\uC5D0
      \uD3EC\uD568\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
    FactKind: 4
    FactSource: {fileID: 11400000, guid: 9971529ae82c8aa43b24453abd9f8d7a, type: 2}
    Clip: {fileID: 0}
    ClipCaption: 
  - Id: combat_drone
    DisplayName: "\uC804\uD22C \uB4DC\uB860"
    Aliases:
    - "\uC804\uD22C \uB4DC\uB860"
    - "\uC804\uD22C\uB4DC\uB860"
    Kind: "\uC6A9\uC5B4"
    KindColor: {r: 0.25, g: 0.57, b: 0.7, a: 1}
    Body: "\uC720\uB2DB \uACC1\uC5D0\uC11C \uBCF4\uC2A4\uB97C \uACF5\uACA9\uD558\uB294
      \uB4DC\uB860\uC785\uB2C8\uB2E4."
    BriefBody: "\uC720\uB2DB \uACC1\uC5D0\uC11C \uBCF4\uC2A4\uB97C \uACF5\uACA9\uD558\uB294
      \uB4DC\uB860\uC785\uB2C8\uB2E4."
    DetailedBody: "\uC77C\uBC18 \uACF5\uACA9\uC744 \uBC18\uBCF5\uD558\uACE0 \uC871\uC7A5
      \uC9D1\uACB0 \uC0AC\uACA9\uC5D0 \uCC38\uC5EC\uD569\uB2C8\uB2E4. \uC790\uD3ED
      \uB4DC\uB860\uC740 \uAC1C\uC218\uC5D0 \uD3EC\uD568\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
    FactKind: 0
    FactSource: {fileID: 0}
    Clip: {fileID: 0}
    ClipCaption: 
  - Id: food
    DisplayName: "\uC2DD\uB7C9"
    Aliases:
    - "\uC2DD\uB7C9"
    Kind: "\uC6A9\uC5B4"
    KindColor: {r: 0.25, g: 0.57, b: 0.7, a: 1}
    Body: "\uC720\uB2DB \uCD9C\uACA9\uACFC \uAC15\uD654\uC5D0 \uC4F0\uB294 \uC7AC\uD654\uC785\uB2C8\uB2E4."
    BriefBody: "\uC720\uB2DB \uCD9C\uACA9\uACFC \uAC15\uD654\uC5D0 \uC4F0\uB294 \uC7AC\uD654\uC785\uB2C8\uB2E4."
    DetailedBody: "\uC720\uB2DB\uACFC \uC804\uD22C \uB4DC\uB860\uC774 \uC0DD\uC0B0\uD558\uBA70,
      \uC0DD\uC0B0\uB7C9\uC740 \uD604\uC7AC \uD6A8\uACFC\uC5D0 \uB530\uB77C \uB2EC\uB77C\uC9D1\uB2C8\uB2E4."
    FactKind: 0
    FactSource: {fileID: 0}
    Clip: {fileID: 0}
    ClipCaption: 
