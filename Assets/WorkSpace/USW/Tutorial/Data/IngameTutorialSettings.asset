  CounterPattern: {fileID: 11400000, guid: a3d687d182678da4aa20c0cc82480787, type: 2}
  TotemSwipeInstruction: "\uC88C\uC6B0\uB85C \uBC00\uC5B4 \uB2E4\uB978 \uD1A0\uD15C\uB3C4
    \uD655\uC778\uD574 \uBCF4\uC138\uC694.\n\uC544\uC9C1 \uC120\uD0DD\uD558\uC9C0
    \uC54A\uACE0 \uD6A8\uACFC\uC640 \uBC94\uC704\uB97C \uC0B4\uD3B4\uBCFC \uAC70\uC608\uC694."
  TotemRotationBadgeInstruction: "\uC774 \uD68C\uC804 \uC544\uC774\uCF58\uC740 \uD1A0\uD15C\uC758
    \uD6A8\uACFC \uBC94\uC704\uB97C \uB3CC\uB9B4 \uC218 \uC788\uB2E4\uB294 \uB73B\uC774\uC5D0\uC694."
  TotemNoRotationInstruction: "\uBE57\uAE08\uC774 \uC788\uB294 \uC544\uC774\uCF58\uC740
    \uD68C\uC804\uD560 \uC218 \uC5C6\uC5B4\uC694."
  TotemBadgeComparisonGap: 16
  TotemReturnInstruction: "\uD655\uC778\uD588\uC73C\uBA74 \uAC00\uC18D \uD1A0\uD15C\uC73C\uB85C
    \uB3CC\uC544\uC640 \uC8FC\uC138\uC694.\n\uC88C\uC6B0\uB85C \uBC00\uC5B4 \uAC00\uC18D
    \uD1A0\uD15C\uC744 \uCC3E\uC544\uBCF4\uC138\uC694."
  ChiefRallyDamageInstruction: "\uC561\uD2F0\uBE0C \uC2A4\uD0AC\uC740 \uB9C9\uAE30\uB9CC
    \uD558\uB294 \uAC8C \uC544\uB2C8\uC5D0\uC694.\n\uB4DC\uB860\uC774 \uBAA8\uC5EC
    \uC3D8\uB294 \uC9D1\uACB0 \uC0AC\uACA9\uC740 \uBCF4\uC2A4\uC5D0\uAC8C \uD070
    \uD53C\uD574\uB97C \uC918\uC694."
  ChiefCooldownInstruction: "\uB2E4\uC2DC \uC4F0\uB824\uBA74 {0}\uCD08\uB97C \uAE30\uB2E4\uB824\uC57C
    \uD574\uC694.\n\uC704\uD5D8\uD55C \uD328\uD134\uC744 \uB9C9\uC744\uC9C0, \uACF5\uACA9\uC5D0
    \uC4F8\uC9C0 \uACE8\uB77C \uBCF4\uC138\uC694."
  TotemRotateSuccessInstruction: "\uAE30\uBCF8 \uB808\uBCA8 2\uC5D0 \uD1A0\uD15C
    +2\uAC00 \uB354\uD574\uC838 4\uB808\uBCA8\uC774 \uB410\uC5B4\uC694. 3\uB808\uBCA8
    \uD6A8\uACFC\uB3C4 \uCF1C\uC838\uC694!"
  CombatPracticeInstruction: "\uC800\uC8FC \uD574\uC81C\uAE4C\uC9C0 \uBC30\uC6E0\uC5B4\uC694.
    \uC774\uC81C \uC0AC\uC2B4\uC744 \uBB3C\uB9AC\uCCD0 \uBCF4\uC138\uC694!"
  MenuOpenInstruction: "\uC804\uD22C \uC911\uC5D0 \uBCFC \uC218 \uC788\uB294 \uC815\uBCF4\uB294
    \uC774 \uBA54\uB274\uC5D0 \uBAA8\uC5EC \uC788\uC5B4\uC694.\n\uBA54\uB274 \uBC84\uD2BC\uC744
    \uB20C\uB7EC \uBCF4\uC138\uC694."
  MenuDamageInstruction: "\uD558\uB2E8 \uBC84\uD2BC \uC601\uC5ED\uC744 \uC67C\uCABD\uC73C\uB85C
    \uBC00\uC5B4 \uBCF4\uC138\uC694.\n\uC2E4\uC2DC\uAC04 \uB51C \uADF8\uB798\uD504\uB85C
    \uBC14\uB00C\uC5B4\uC694."
  MenuDamageExplanation: "\uCE90\uB9AD\uD130 \uADF8\uB9BC\uACFC \uB9C9\uB300\uB85C
    \uB204\uAC00 \uC5BC\uB9C8\uB098 \uD53C\uD574\uB97C \uC92C\uB294\uC9C0 \uBCFC
    \uC218 \uC788\uC5B4\uC694.\n\uC804\uD22C \uC911\uC5D0\uB3C4 \uC2E4\uC2DC\uAC04\uC73C\uB85C
    \uAC31\uC2E0\uB3FC\uC694."
  MenuDamageReturnInstruction: "\uC774\uBC88\uC5D0\uB294 \uC624\uB978\uCABD\uC73C\uB85C
    \uBC00\uC5B4\n\uCD9C\uACA9, \uAC15\uD654, \uC561\uD2F0\uBE0C \uC2A4\uD0AC, \uD1A0\uD15C
    \uBC84\uD2BC\uC73C\uB85C \uB3CC\uC544\uAC00 \uBCF4\uC138\uC694."
  MenuReopenInstruction: "\uBA54\uB274\uB97C \uB2E4\uC2DC \uC5F4\uC5B4 \uBCF4\uC138\uC694."
  MenuSelectionInstruction: "\uC774\uBC88\uC5D4 \uC120\uD0DD\uC9C0\uB97C \uB20C\uB7EC
    \uBCF4\uC138\uC694."
  MenuSelectionExplanation: "\uB808\uBCA8\uC5C5\uC5D0\uC11C \uC5BB\uC740 \uC120\uD0DD\uC9C0\uB294
    \uC5EC\uAE30\uC5D0 \uBAA8\uC5EC\uC694.\n\uBAA8\uC11C\uB9AC\uC758 \uC5BC\uAD74\uC774
    \uD6A8\uACFC\uB97C \uBC1B\uB294 \uC720\uB2DB\uC774\uC5D0\uC694."
  MenuSettingsExplanation: "\uC18C\uB9AC\uC640 \uC9C4\uB3D9\uC740 \uC5EC\uAE30 \uC124\uC815\uC5D0\uC11C
    \uBC14\uAFC0 \uC218 \uC788\uC5B4\uC694.\n\uD29C\uD1A0\uB9AC\uC5BC \uC911\uC5D0\uB294
    \uC7A0\uC2DC \uC774\uC6A9\uD560 \uC218 \uC5C6\uC5B4\uC694."
