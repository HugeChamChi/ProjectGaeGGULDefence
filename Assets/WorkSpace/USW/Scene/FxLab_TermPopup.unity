  _cardData:
  - {fileID: 11400000, guid: a38e8efd723635e4c9a1ead2f22e8645, type: 2}
  - {fileID: 11400000, guid: d7b716518b1c92b44a95a21f1ef4cc5f, type: 2}
  - {fileID: 11400000, guid: 68e6d86379d56be41881f24652b48c47, type: 2}
  _descriptions:
  - "[[\uC561\uD2F0\uBE0C \uC2A4\uD0AC]]\uC758 \uD53C\uD574\uB7C9\uC774 40% \uC99D\uAC00\uD569\uB2C8\uB2E4."
  - "\uBCA0\uD0D5\uC758 [[\uC804\uD22C \uB4DC\uB860]] \uACF5\uACA9 \uC18D\uB3C4\uAC00
    20% \uC99D\uAC00\uD558\uACE0, \uC801\uC911 \uC2DC [[\uD654\uC0C1]]\uC744 1\uC911\uCCA9
    \uBD80\uC5EC\uD569\uB2C8\uB2E4."
  - "10\uCD08\uB9C8\uB2E4 [[\uC790\uD3ED \uB4DC\uB860]] 1\uAE30\uB97C \uCD94\uAC00\uB85C
    \uBC1C\uC0AC\uD558\uACE0, \uD3ED\uBC1C\uD55C \uBCF4\uC2A4\uC5D0\uAC8C [[\uC544\uBA38\uBE0C\uB808\uC774\uD06C]]\uB97C
    \uBD80\uC5EC\uD569\uB2C8\uB2E4."
  _terms:
  - Id: "\uC561\uD2F0\uBE0C \uC2A4\uD0AC"
    Kind: "\uADDC\uCE59"
    KindColor: {r: 0.42, g: 0.44, b: 0.53, a: 1}
    Short: "\uC2A4\uD0AC \uAC8C\uC774\uC9C0\uAC00 \uCC28\uBA74 \uC790\uB3D9\uC73C\uB85C
      \uC4F0\uB294 \uC720\uB2DB \uACE0\uC720 \uAE30\uC220."
    Body: "\uB4DC\uB860 \uC720\uB2DB\uC758 \uC2A4\uD0AC \uAC8C\uC774\uC9C0\uAC00
      \uAC00\uB4DD \uCC28\uBA74 \uC790\uB3D9\uC73C\uB85C \uBC1C\uB3D9\uD558\uB294
      \uACE0\uC720 \uAE30\uC220\uC785\uB2C8\uB2E4. \uC720\uB2DB\uB9C8\uB2E4 \uD6A8\uACFC\uAC00
      \uB2E4\uB974\uBA70, \uCFE8\uD0C0\uC784\xB7\uD53C\uD574\uB7C9 \uC120\uD0DD\uC9C0\uC758
      \uB300\uC0C1\uC774 \uB429\uB2C8\uB2E4."
    Facts: 
  - Id: "\uC804\uD22C \uB4DC\uB860"
    Kind: "\uC720\uB2DB"
    KindColor: {r: 0.298, g: 0.553, b: 0.941, a: 1}
    Short: "\uBCA0\uD0D5 \uC8FC\uC704\uB97C \uB9F4\uB3CC\uBA70 \uC790\uB3D9 \uACF5\uACA9\uD558\uB294
      \uB4DC\uB860."
    Body: "\uBCA0\uD0D5\uC744 \uBC30\uCE58\uD558\uBA74 \uD568\uAED8 \uB098\uC640
      \uC8FC\uC704\uB97C \uB9F4\uB3C4\uB294 \uB4DC\uB860\uC785\uB2C8\uB2E4. \uBCA0\uD0D5\uC758
      \uACF5\uACA9\uB825\uC744 \uB530\uB77C \uBCF4\uC2A4\uB97C \uC790\uB3D9 \uACF5\uACA9\uD558\uACE0,
      \uBCA0\uD0D5\uC744 \uD68C\uC218\uD558\uBA74 \uC0AC\uB77C\uC9D1\uB2C8\uB2E4."
    Facts: 
  - Id: "\uD654\uC0C1"
    Kind: "\uB514\uBC84\uD504"
    KindColor: {r: 0.886, g: 0.408, b: 0.235, a: 1}
    Short: "\uC77C\uC815 \uAC04\uACA9\uC73C\uB85C \uD53C\uD574\uB97C \uC8FC\uB294
      \uC0C1\uD0DC \uC774\uC0C1."
    Body: "\uAC78\uB9B0 \uBCF4\uC2A4\uC5D0\uAC8C \uC77C\uC815 \uAC04\uACA9\uC73C\uB85C
      \uD53C\uD574\uB97C \uC90D\uB2C8\uB2E4. \uC911\uCCA9\uC774 \uC313\uC77C\uC218\uB85D
      \uD53C\uD574\uAC00 \uCEE4\uC9C0\uACE0, \uC9C0\uC18D \uC2DC\uAC04\uC774 \uB05D\uB098\uBA74
      \uC0AC\uB77C\uC9D1\uB2C8\uB2E4."
    Facts: "\uCD5C\uB300 5\uC911\uCCA9 \xB7 \uC9C0\uC18D 4\uCD08 \xB7 0.5\uCD08\uB9C8\uB2E4"
  - Id: "\uC790\uD3ED \uB4DC\uB860"
    Kind: "\uC720\uB2DB"
    KindColor: {r: 0.298, g: 0.553, b: 0.941, a: 1}
    Short: "\uBCF4\uC2A4\uC5D0\uAC8C \uB0A0\uC544\uAC00 \uD130\uC9C0\uB294 \uC77C\uD68C\uC6A9
      \uB4DC\uB860."
    Body: "\uBCF4\uC2A4\uB97C \uD5A5\uD574 \uB0A0\uC544\uAC00 \uB3C4\uCC29\uD558\uC790\uB9C8\uC790
      \uD3ED\uBC1C\uD558\uB294 \uC77C\uD68C\uC6A9 \uB4DC\uB860\uC785\uB2C8\uB2E4.
      \uD3ED\uBC1C \uD53C\uD574\uB294 \uBC1C\uC0AC\uD55C \uC720\uB2DB\uC758 \uACF5\uACA9\uB825\uC744
      \uB530\uB985\uB2C8\uB2E4."
    Facts: 
  - Id: "\uC544\uBA38\uBE0C\uB808\uC774\uD06C"
    Kind: "\uB514\uBC84\uD504"
    KindColor: {r: 0.886, g: 0.408, b: 0.235, a: 1}
    Short: "\uBCF4\uC2A4 \uBC29\uC5B4\uB97C \uAE4E\uC544 \uBC1B\uB294 \uD53C\uD574\uB97C
      \uB298\uB9BC."
    Body: "\uBCF4\uC2A4\uC758 \uBC29\uC5B4\uB97C \uAE4E\uC544 \uBAA8\uB4E0 \uACF5\uACA9\uC5D0
      \uBC1B\uB294 \uD53C\uD574\uAC00 \uB298\uC5B4\uB0A9\uB2C8\uB2E4. \uC911\uCCA9\uC774
      \uC313\uC77C\uC218\uB85D \uD6A8\uACFC\uAC00 \uCEE4\uC9D1\uB2C8\uB2E4."
    Facts: "\uCD5C\uB300 10\uC911\uCCA9 \xB7 \uC9C0\uC18D 6\uCD08 \xB7 \uC911\uCCA9\uB2F9
      \uD53C\uD574 +3%"
  _mode: 2
  _hitPadding: 18
  _termColor: {r: 0.5, g: 0.83, b: 0.93, a: 1}
  _dimAlpha: 0.35
  _sheetClearance: 30
  _shiftDuration: 0.28
  _punchySheet: 1
  _cardPunch: 0.05
