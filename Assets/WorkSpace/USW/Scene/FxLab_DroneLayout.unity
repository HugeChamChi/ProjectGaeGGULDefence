  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DroneLayoutLab
  _unitTemplates:
  - {fileID: 8938791068899562930}
  - {fileID: 3797474198239277894}
  - {fileID: 2697215719033672055}
  - {fileID: 5170484844565731399}
  - {fileID: 3907023870902867235}
  _droneTemplates:
  - {fileID: 4795457851834017705}
  - {fileID: 979632238951703897}
  - {fileID: 8899519387508325097}
  _cellOrigin: {x: -2.72, y: -3.03}
  _cellStep: 1.088
  _unitOffsetY: -0.2
  _currentSlots:
  - {x: -0.537, y: 0.18}
  - {x: 0.613, y: 0.18}
  - {x: -0.24949999, y: -0.17420003}
  - {x: 0.32549995, y: -0.17420003}
  - {x: 0.038, y: -0.46169996}
  _variants:
  - Label: "\uD604\uC7AC"
    Description: "\uAC8C\uC784 \uADF8\uB300\uB85C \u2014 5\uC2AC\uB86F(BetanFormationSettings),
      \uB4DC\uB860 0.9, \uC624\uB108 \uBC14\uB85C \uC55E"
    Kind: 0
    DroneScale: 1
    UnitScale: 1
    Spread: 1
  - Label: "A \uCD95\uC18C"
    Description: "\uD604\uC7AC \uC2AC\uB86F\uC744 75%\uB85C \uC548\uCABD\uC73C\uB85C
      \uB2F9\uAE30\uACE0 \uB4DC\uB860 75%"
    Kind: 1
    DroneScale: 0.75
    UnitScale: 1
    Spread: 0.75
  - Label: "B \uBA38\uB9AC \uC704 \uC77C\uB82C"
    Description: "\uB4DC\uB860\uC744 \uBA38\uB9AC \uC704 \uAC00\uB85C \uD55C \uC904\uB85C
      \u2014 \uC606 \uCE78 \uC720\uB2DB\uACFC \uC548 \uACB9\uCE68, \uC704 \uCE78
      \uBC1C\uBC11\uACFC\uB9CC \uB9CC\uB0A8"
    Kind: 2
    DroneScale: 0.7
    UnitScale: 1
    Spread: 1.25
  - Label: "C \uD6C4\uAD11 \uC544\uCE58"
    Description: "\uBA38\uB9AC \uC704 \uBC18\uC6D0 \u2014 \uC720\uB2DB \uC2E4\uB8E8\uC5E3\uC740
      \uB2E4 \uBCF4\uC774\uACE0 \uB4DC\uB860\uC740 \uC655\uAD00\uCC98\uB7FC"
    Kind: 3
    DroneScale: 0.7
    UnitScale: 1
    Spread: 1.15
  - Label: "D \uBC1C\uBC11 \uC904"
    Description: "\uCE78 \uC544\uB798\uCABD\uC5D0 \uD55C \uC904\uB85C \u2014 \uC720\uB2DB
      \uC55E, \uC544\uB798 \uCE78 \uBA38\uB9AC\uC640 \uB9CC\uB098\uB294\uC9C0 \uD655\uC778"
    Kind: 4
    DroneScale: 0.65
    UnitScale: 1
    Spread: 1.2
  - Label: "E \uB4F1 \uB4A4"
    Description: "\uC720\uB2DB \uB4A4\uC5D0 \uBD80\uCC44\uAF34\uB85C \uC228\uAE40
      \u2014 \uB0A0\uAC1C\uCC98\uB7FC \uC5B4\uAE68 \uB108\uBA38\uB85C\uB9CC \uBCF4\uC784"
    Kind: 5
    DroneScale: 0.8
    UnitScale: 1
    Spread: 1
  - Label: "F \uCE78 \uBAA8\uC11C\uB9AC"
    Description: "\uC790\uAE30 \uCE78 \uB124 \uBAA8\uC11C\uB9AC + \uC704 \uAC00\uC6B4\uB370
      \u2014 \uCE78 \uACBD\uACC4\uB97C \uB118\uC9C0 \uC54A\uC74C"
    Kind: 6
    DroneScale: 0.65
    UnitScale: 1
    Spread: 1
  - Label: "G \uB4F1\uCABD \uC138\uB85C\uC5F4"
    Description: "\uBCF4\uB294 \uBC29\uD5A5 \uBC18\uB300(\uBC14\uAE65\uCABD) \uC606\uC5D0
      \uC138\uB85C\uB85C \uC313\uAE30"
    Kind: 7
    DroneScale: 0.65
    UnitScale: 1
    Spread: 1.1
  - Label: "H \uADA4\uB3C4 \uD68C\uC804"
    Description: "\uC720\uB2DB \uB458\uB808\uB97C \uB0A9\uC791\uD558\uAC8C \uD68C\uC804,
      \uC704\uCABD \uBC18\uC740 \uC720\uB2DB \uB4A4\uB85C"
    Kind: 8
    DroneScale: 0.7
    UnitScale: 1
    Spread: 1
  - Label: "I \uC720\uB2DB \uCD95\uC18C"
    Description: "\uC720\uB2DB 88% + \uD604\uC7AC \uC2AC\uB86F 85% + \uB4DC\uB860
      85% \u2014 \uB458 \uB2E4 \uC870\uAE08\uC529 \uC904\uC784"
    Kind: 9
    DroneScale: 0.85
    UnitScale: 0.88
    Spread: 0.85
  - Label: "J \uB300\uD45C1+\uC22B\uC790"
    Description: "\uB4DC\uB860 1\uAE30\uB9CC \uADF8\uB9AC\uACE0 \xD74 \uC22B\uC790
      \u2014 \uC0AC\uACA9\uC740 \uB300\uD45C \uB4DC\uB860\uC5D0\uC11C"
    Kind: 10
    DroneScale: 0.85
    UnitScale: 1
    Spread: 1
  - Label: "K \uD558\uB298 \uACA9\uB0A9"
    Description: "\uB4DC\uB860\uC774 \uADF8\uB9AC\uB4DC\uB97C \uB5A0\uB098 \uADF8\uB9AC\uB4DC
      \uC704 \uD558\uB298 \uB760\uC5D0 \uCE78\uBCC4\uB85C \uBAA8\uC784 \u2014 \uADF8\uB9AC\uB4DC\uC5D4
      \uC720\uB2DB\uB9CC"
    Kind: 11
    DroneScale: 0.6
    UnitScale: 1
    Spread: 1.2
  - Label: "L \uC5B4\uAE68 \uD0D1\uC2B9"
    Description: "\uC720\uB2DB \uC5B4\uAE68 \uC704\uC5D0 \uC791\uAC8C \u2014 \uC790\uAE30
      \uBAB8 \uBC94\uC704 \uBC16\uC73C\uB85C \uC548 \uB098\uAC10"
    Kind: 12
    DroneScale: 0.6
    UnitScale: 1
    Spread: 1.4
  - Label: "M \uCD95\uC18C+\uB4F1 \uB4A4"
    Description: "\uC720\uB2DB 88% + \uB4F1 \uB4A4 \uBD80\uCC44\uAF34 \uB4DC\uB860
      80% \u2014 I\uC640 E \uC870\uD569"
    Kind: 5
    DroneScale: 0.8
    UnitScale: 0.88
    Spread: 1
  - Label: "N \uCD95\uC18C+\uBA38\uB9AC \uC704"
    Description: "\uC720\uB2DB 88% + \uBA38\uB9AC \uC704 \uC77C\uB82C \uB4DC\uB860
      70% \u2014 I\uC640 B \uC870\uD569"
    Kind: 2
    DroneScale: 0.7
    UnitScale: 0.88
    Spread: 1.25
